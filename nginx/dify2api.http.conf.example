# Dify2API Nginx 反代配置(纯 HTTP,不强制跳转)
# 适用:本机/内网部署,或上层另有 TLS 终止(如 Cloudflare)的场景。
#
# 安装:
#   sudo cp dify2api.http.conf.example /etc/nginx/sites-available/dify2api.conf
#   sudo ln -s /etc/nginx/sites-available/dify2api.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo nginx -s reload

server {
    listen 80;
    # 必须与 SITE_BASE_URL / ADMIN_HOST 一致；应用会拒绝未知 Host。
    server_name api.your-domain.com admin.api.your-domain.com;
    client_max_body_size 10m;

    location / {
        proxy_pass http://localhost:10086;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 覆盖而不是追加客户端可伪造的 X-Forwarded-For。
        # 若前方还有 Cloudflare/LB，请先用 nginx real_ip 模块验证其来源，
        # 再让 $remote_addr 表示真实客户端；不要直接转发来路 XFF。
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE 流式必须关闭缓冲
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
