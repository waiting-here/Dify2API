# Dify2API Nginx 反代配置(纯 HTTP,不强制跳转)
# 适用:本机/内网部署,或上层另有 TLS 终止(如 Cloudflare)的场景。
#
# 安装:
#   sudo cp dify2api.http.conf.example /etc/nginx/sites-available/dify2api.conf
#   sudo ln -s /etc/nginx/sites-available/dify2api.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo nginx -s reload

server {
    listen 80;
    server_name api.your-domain.com;   # ← 替换为你的域名,本机使用可写 _

    location / {
        proxy_pass http://localhost:10086;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE 流式必须关闭缓冲
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
