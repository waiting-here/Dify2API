# Dify2API 启动配置文件(通过 -admin <path> 指定,必填)
# 本文件是全部配置的唯一来源;同名 OS 环境变量可覆盖任意项。
# ⚠️ 本文件含机密信息,请设置 0600 权限。

# ── 管理员账号(必填)────────────────────────────
# 网页端管理员登录用(管理员无 Dify App 配置界面,
# 如需使用服务请自行以 Discord 注册一个普通用户)
ADMIN_USERNAME=admin
# 管理员密码:支持明文,或 bcrypt 哈希($2a$/$2b$/$2y$ 前缀,推荐)
ADMIN_PASSWORD=change-me

# ── Discord OAuth(必填)────────────────────────
# 在 https://discord.com/developers/applications 创建 Application 后获得
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# 本网关的公开地址(用于构造 Discord OAuth 回调:
#   <SITE_BASE_URL>/auth/discord/callback
# 必须与 Developer Portal 中登记的 Redirect 完全一致)
SITE_BASE_URL=https://dify2api.example.com

# 管理站点域名(可选,默认 admin.<SITE_BASE_URL 的域名>)
# ADMIN_HOST=admin.dify2api.example.com

# ── 站点信息(可选,有默认值)──────────────────
# 网站对外显示的名称及积分名称等可配置文本的多语言版本
# 通过 I18N_FILE 指向的 JSON 字典文件提供（格式见 i18n.json.example）
# 模板值 i18n.json.example 是随仓库提供的参考文件；未配置时默认空（使用内置默认文本：站点名称 "Dify2API"，积分名称 "公益 Dify2API 积分"）
I18N_FILE=i18n.json.example

# 举报 / DMCA 联络邮箱(默认 report@example.com; 显示在服务协议和隐私政策页面)
# 用于接收版权投诉(DMCA)及 CSAM 等违法内容举报。部署前请设为真实可达邮箱。
REPORT_EMAIL=report@example.com

# 网站图标(浏览器标签页小图标, 可选, 默认无)
# 支持 .ico / .png / .svg / .gif / .webp / .jpg / .jpeg
# 填写本地文件路径, 如 /home/user/my-icon.png
FAVICON_PATH=

# ── 服务与存储(可选,有默认值)──────────────────
# 监听地址(默认 localhost:10086)
# ⚠️ 安全约束:请勿将此地址暴露到公网。Go 服务必须仅接受来自受信任
# 反向代理(nginx)的本地连接,因为中间件信任 X-Forwarded-* 头部。
LISTEN_ADDR=localhost:10086

# SQLite 数据库文件路径(默认 ./dify2api.db)
DIFY2API_DB_PATH=dify2api.db

# 加密主密钥文件路径(默认 ./dify2api.key;首启自动生成,0600 权限)
# ⚠️ 备份 = 数据库文件 + 此密钥文件;密钥文件丢失则已存密钥全部不可恢复
DIFY2API_MASTER_KEY_PATH=dify2api.key

# 调用 Dify API 的单次请求超时(毫秒,默认 900000 = 900 秒/15 分钟)
DIFY_HTTP_TIMEOUT_MS=900000

# ── 防护与性能调优(可选,有默认值)──────────────
# 全局并发聊天请求上限(默认 32;超出返回 429 server_busy)
MAX_CHAT_IN_FLIGHT=32

# /v1/chat/completions 请求体上限(MB,默认 10;超出返回 413)
MAX_REQUEST_BODY_MB=10

# 每条流式连接的 SSE 初始缓冲(MB,默认 10;单行硬上限固定 50MB)
# 内存估算:并发数 × (此值 + 平均请求体)
SSE_BUFFER_MB=10

# 管理员登录爆破防护:
# 窗口内失败达到此次数即锁定(默认 5)
LOGIN_MAX_FAILURES=5
# 失败计数滑动窗口(分钟,默认 10)
LOGIN_WINDOW_MIN=10
# 锁定时长(分钟,默认 60)
LOGIN_LOCK_MIN=60
# 登录响应恒定时延(毫秒,默认 300)
LOGIN_MIN_LATENCY_MS=300

# ── 公益积分(可选,有默认值)──────────────
# 积分统计值的对外显示名称通过 I18N_FILE 字典中的 credits_name 配置
# 未配置时默认"公益 Dify2API 积分"

# 积分 logo：文本 / emoji（默认 🌟）
# 与 CREDITS_LOGO_PATH 同时配置时，后者优先生效
CREDITS_LOGO_TEXT=🌟

# 积分 logo：本地图片路径（如 /home/user/credits-logo.png）
# 支持 .ico / .png / .svg / .gif / .webp / .jpg / .jpeg
CREDITS_LOGO_PATH=

# 签到日时区偏移（小时，默认 0 = UTC+0；范围 -12..14）
# 例如：中国时区（UTC+8）设为 8
CHECKIN_TZ_OFFSET=0

# ── 邮件提醒（SMTP,可选,默认关闭）────────
# 未配置 SMTP_HOST 时邮件功能静默关闭
# 详细配置教程见 README（alpha.3 S6 交付）
# 常见示例：
#   Gmail（需应用专用密码）: SMTP_HOST=smtp.gmail.com SMTP_PORT=587
#   腾讯企业邮: SMTP_HOST=smtp.exmail.qq.com SMTP_PORT=465 SMTP_TLS=implicit
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 发件人地址；未设置时回退到 SMTP_USER
SMTP_FROM=
# 收件人地址（管理员邮箱）
SMTP_TO=
# TLS 方式：starttls（典型 587）或 implicit（典型 465）
# 未设置时按端口自动检测：465→implicit，其余→starttls
SMTP_TLS=

# ── Web 限流(可选,有默认值)──────────────
# /api/* Web 请求每 IP 每分钟上限（默认 120；设 0 关闭 Web IP 限流）
WEB_RPM_PER_IP=120

# 超限后返回 429 的持续时间（秒,默认 60）
WEB_THROTTLE_SEC=60

# /v1/* 无效密钥每 IP 每分钟上限（默认 30；设 0 关闭无效密钥节流）
AUTH_FAIL_RPM_PER_IP=30

# ── 内部窗口与截断（可选，有默认值）────────
# 三类 RPM 滑动窗口大小（秒，默认 60）
RPM_WINDOW_SEC=60

# IP 限流滑动窗口大小（秒，默认 60）
IP_THROTTLE_WINDOW_SEC=60

# 请求日志错误详情截断长度（字符，默认 500）
LOG_DETAIL_MAX_CHARS=500
